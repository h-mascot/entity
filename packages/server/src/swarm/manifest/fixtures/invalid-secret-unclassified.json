{
  "schemaVersion": "1.0.0",
  "kind": "execution-engine",
  "identity": {
    "id": "swarm.symphony",
    "name": "symphony",
    "label": "Symphony bad secret class",
    "version": "1.0.0",
    "category": "orchestration"
  },
  "execution": {
    "mode": "pull",
    "acceptsDispatch": true,
    "entityPollsProvider": false,
    "expectsClaimCallbacks": true
  },
  "lifecycle": {
    "dispatch": true,
    "status": true,
    "cancel": true,
    "collectProof": true,
    "claimCallback": true,
    "releaseCallback": true,
    "proofCallback": true,
    "completeCallback": true,
    "failCallback": true
  },
  "callbacks": {
    "intake": [
      {
        "event": "claim",
        "method": "POST",
        "pathTemplate": "/api/swarm/jobs/:id/claim",
        "authRequired": true,
        "idempotent": false
      }
    ]
  },
  "statusMapping": {
    "afterDispatch": "queued",
    "runStateToJobStatus": {}
  },
  "health": {
    "publicFields": ["available", "message"],
    "privateFields": [],
    "allowUrlsInPublicMessage": false,
    "allowPathsInPublicMessage": false
  },
  "config": {
    "bindings": [
      {
        "key": "SYMPHONY_API_KEY",
        "source": "env",
        "required": false,
        "secret": false,
        "description": "Incorrectly unclassified secret"
      }
    ]
  },
  "dangerousActions": [],
  "activityEvents": { "emits": [] }
}
