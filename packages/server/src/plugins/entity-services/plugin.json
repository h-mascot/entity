{
  "id": "entity-services",
  "name": "Entity Services",
  "version": "0.1.0",
  "kind": "integration",
  "description": "Operational services registry for Entity, Enterprise tooling, and adjacent runtime services.",
  "capabilities": [
    "api.routes.register",
    "ui.top-level.register",
    "admin.settings.register"
  ],
  "hooks": [],
  "entrypoints": {
    "ui": "./packages/app/src/components/EntityServicesBoard.tsx"
  },
  "ui": {
    "mountPoint": { "type": "top-level-tab" },
    "component": "EntityServicesBoard",
    "label": "Services",
    "icon": "🛰️"
  },
  "routes": [
    { "basePath": "/api/entity-services", "entry": "./routes.ts" }
  ],
  "settings": {
    "requestTimeoutMs": 3500,
    "discoverGatewayServices": true,
    "discoverMacServices": true,
    "macDiscoverySshTarget": null,
    "macDiscoveryPublicHost": null
  }
}
