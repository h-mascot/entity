# Entity server environment — local-safe defaults.
ENTITY_CONFIG=../../entity.config.yaml
ENTITY_DB_MODE=LOCAL
ENTITY_CLOUD_API_BASE=http://localhost:3000
VITE_MC_ORIGIN=http://localhost:3000
VITE_ENTITY_API_BASE=http://localhost:3000
ENTITY_FS_MULTISOURCE=true
ENTITY_FS_INDEXER_ENABLED=false
VITE_ENTITY_WS_PORT=3000
ENTITY_AGENT_ENABLED=false
PORT=3000

# Optional auth. Leave empty for local development; set before exposing the API.
ENTITY_API_TOKEN=
ENTITY_DEFAULT_DOCUMENTS_TOKEN=

# Optional external services/providers. Disabled until explicitly configured.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
EFORGE_API_URL=http://localhost:4567
EFORGE_QUEUE_DIR=

# Optional error tracking.
SENTRY_DSN=
VITE_SENTRY_DSN=
