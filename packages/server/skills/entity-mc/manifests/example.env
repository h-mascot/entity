# Safe example manifest for local testing. Real onboarding sessions should use
# the manifest endpoint from the running Entity app.
ENTITY_MC_ENTITY_URL="http://localhost:3000"
ENTITY_MC_ONBOARDING_TOKEN="replace-with-setup-token"
ENTITY_MC_INSTALL_DIR="${HOME}/.entity-mc"
ENTITY_MC_BIN_DIR="${HOME}/.local/bin"
