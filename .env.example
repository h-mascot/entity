# Entity Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER CONFIGURATION (local development defaults)
# =============================================================================
ENTITY_DB_MODE=LOCAL
ENTITY_CLOUD_API_BASE=http://localhost:3000
VITE_MC_ORIGIN=http://localhost:3000
VITE_ENTITY_API_BASE=http://localhost:3000
ENTITY_FS_MULTISOURCE=true
ENTITY_FS_INDEXER_ENABLED=false
VITE_ENTITY_WS_PORT=3000

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Token for default document access (leave empty to disable)
ENTITY_DEFAULT_DOCUMENTS_TOKEN=

# =============================================================================
# OPTIONAL: Sentry error tracking
# =============================================================================
SENTRY_DSN=
VITE_SENTRY_DSN=

# =============================================================================
# OPTIONAL: External services
# =============================================================================
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# CLIENT-SIDE OVERRIDES (Vite/frontend)
# =============================================================================
# Local Ollama server URL for ChatOfflineProvider (default: http://localhost:11434)
# VITE_OLLAMA_BASE_URL=http://localhost:11434

# Source path shown in onboarding config (default: empty — user enters manually)
# VITE_SOURCE_PATH=/Users/bob/Code/entity
