# Entity Environment Configuration
# Copy this file to .env for local development. Values are public-safe defaults.

# =============================================================================
# SERVER CONFIGURATION (local development defaults)
# =============================================================================
ENTITY_CONFIG=entity.config.yaml
ENTITY_DB_MODE=LOCAL
# Optional override; npm run dev resolves entity.config.yaml server.databasePath automatically.
ENTITY_TASK_DB_PATH=./data/entity.sqlite
ENTITY_CLOUD_API_BASE=http://localhost:3000
VITE_MC_ORIGIN=http://localhost:3000
VITE_ENTITY_API_BASE=http://localhost:3000
VITE_ENTITY_WS_PORT=3000
ENTITY_FS_MULTISOURCE=true
ENTITY_FS_INDEXER_ENABLED=false
PORT=3000

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Leave empty for local unauthenticated development. Set to a random value before
# exposing Entity beyond localhost. Generate with: openssl rand -hex 32
ENTITY_API_TOKEN=
ENTITY_DEFAULT_DOCUMENTS_TOKEN=

# =============================================================================
# OPTIONAL: Error tracking
# =============================================================================
SENTRY_DSN=
VITE_SENTRY_DSN=

# =============================================================================
# OPTIONAL: External providers (disabled until explicitly configured)
# =============================================================================
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# =============================================================================
# CLIENT-SIDE OVERRIDES (Vite/frontend)
# =============================================================================
# VITE_OLLAMA_BASE_URL=http://localhost:11434
# VITE_SOURCE_PATH=
