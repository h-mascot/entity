import { useEffect, useMemo, useRef, useState } from 'react';
import type { ActivityEntry, ActivityType } from '../hooks/useActivityStream';

interface ActivityStreamProps {
  activities: ActivityEntry[];
  isOpen: boolean;
  onToggleOpen: () => void;
  onOpenFile: (path: string) => void;
}

const TYPE_ICON: Record<ActivityType, string> = {
  file_edit: '📝',
  tool_call: '🛠️',
  message_sent: '💬',
  command_run: '⌘',
  research: '🔎',
  thinking: '🧠',
};

function getAgentStyles(agentName: string): string {
  const normalized = agentName.toLowerCase();

  if (normalized === 'ada') {
    return 'border-purple-400/70 bg-purple-900/20 hover:bg-purple-900/35';
  }

  if (normalized === 'spock') {
    return 'border-blue-400/70 bg-blue-900/20 hover:bg-blue-900/35';
  }

  if (normalized === 'scotty') {
    return 'border-orange-400/70 bg-orange-900/20 hover:bg-orange-900/35';
  }

  return 'border-gray-600 bg-gray-800/60 hover:bg-gray-700/70';
}

function formatRelativeTime(timestamp: string, nowMs: number): string {
  const ts = new Date(timestamp).getTime();
  if (Number.isNaN(ts)) {
    return 'now';
  }

  const deltaSeconds = Math.max(0, Math.floor((nowMs - ts) / 1000));
  if (deltaSeconds < 60) {
    return "'`${deltaSeconds}s ago`;
  }

  const deltaMinutes = Math.floor(deltaSeconds / 60);
  if (deltaMinutes < 60) {
    return `${deltaMinutes}m ago`;
  }

  const deltaHours = Math.floor(deltaMinutes / 60);
  if (deltaHours < 24) {
    return `${deltaHours}h ago`;
  }

  const deltaDays = Math.floor(deltaHours / 24);
  return `${deltaDays}d ago`;
}

export default function ActivityStream({
  activities,
  isOpen,
  onToggleOpen,
  onOpenFile,
}: ActivityStreamProps) {
  const [autoScrollEnabled, setAutoScrollEnabled] = useState(true);
  const [nowMs, setNowMs] = useState(() => Date.now());
  const listRef = useRef<HTMLDivElement | null>(null);

  const sortedActivities = useMemo(() => [...activities].reverse(), [activities]);

  useEffect(() => {
    const intervalId = window.setInterval(() => {
      setNowMs(Date.now());
    }, 1000);

    return () => {
      window.clearInterval(intervalId);
    };
  }, []);

  useEffect(() => {
    if (!isOpen || !autoScrollEnabled || !listRef.current) {
      return;
    }

    listRef.current.scrollTop = listRef.current.scrollHeight;
  }, [autoScrollEnabled, isOpen, sortedActivities]);

  return (
    <div className="border-t border-gray-700 bg-gray-850/60 backdrop-blur-sm">
      <div className="flex items-center justify-between px-4 py-2 border-b border-gray-700 bg-gray-800/70">
        <div className="text-sm font-semibold text-gray-200">Activity Stream</div>
        <div className="flex items-center gap-2">
          {isOpen && (
            <button
              type="button"
              onClick={() => setAutoScrollEnabled((prev) => !prev)}
              className={`px-2 py-1 text-xs rounded transition-colors ${
                autoScrollEnabled
                  ? '"'bg-gray-700 text-gray-200 hover:bg-gray-600'
                  : 'bg-amber-700/70 text-amber-100 hover:bg-amber-600/70'
              }"'`}
            >
              {autoScrollEnabled ? '"'Pause auto-scroll' : 'Resume auto-scroll'}
            </button>
          )}
          <button
            type=\"button\"
            onClick={onToggleOpen}
            className=\"px-2 py-1 text-xs rounded bg-gray-700 text-gray-200 hover:bg-gray-600 transition-colors\"
          >
            {isOpen ? 'Hide panel' : 'Show panel'}
          </button>
        </div>
      </div>

      {isOpen && (
        <div ref={listRef} className=\"h-64 overflow-y-auto px-3 py-2 space-y-2\">
          {sortedActivities.length === 0 ? (
            <div className=\"text-sm text-gray-400 px-2 py-3\">Waiting for agent activity...</div>
          ) : (
            sortedActivities.map((entry) => {
              const containerClass = "'`w-full text-left rounded-md border-l-4 border border-gray-700/70 px-3 py-2 transition-colors ${getAgentStyles(entry.agentName)}`;
              const timeLabel = formatRelativeTime(entry.timestamp, nowMs);
              const content = (
                <>
                  <div className="flex items-center gap-2 text-xs text-gray-300">
                    <span>{TYPE_ICON[entry.type]}</span>
                    <span>{entry.agentEmoji}</span>
                    <span className="font-semibold text-gray-100">{entry.agentName}</span>
                    <span className="ml-auto text-gray-400">{timeLabel}</span>
                  </div>
                  <div className="mt-1 text-sm text-gray-100">
                    <span className="font-medium">{entry.action}</span>
                    <span className="text-gray-300"> · {entry.description}</span>
                  </div>
                  {entry.filePath && (
                    <div className="mt-1 text-xs text-blue-300 truncate">Open file: {entry.filePath}</div>
                  )}
                </>
              );

              if (entry.filePath) {
                return (
                  <button
                    key={entry.id}
                    type="button"
                    className={containerClass}
                    onClick={() => onOpenFile(entry.filePath!)}
                    title={`Open ${entry.filePath}`}
                  >
                    {content}
                  </button>
                );
              }

              return (
                <div key={entry.id} className={containerClass}>
                  {content}
                </div>
              );
            })
          )}
        </div>
      )}
    </div>
  );
}
