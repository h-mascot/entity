diff --git a/packages/app/src/hooks/useActivityStream.ts b/packages/app/src/hooks/useActivityStream.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4e161d1c050b75a13bf2ff2357a26dd77e8f3de7
--- /dev/null
+++ b/packages/app/src/hooks/useActivityStream.ts
@@ -0,0 +1,341 @@
+import { useCallback, useEffect, useState } from 'react';
+import { create } from 'zustand';
+
+export type ActivityType =
+  | 'file_edit'
+  | 'tool_call'
+  | 'message_sent'
+  | 'command_run'
+  | 'research'
+  | 'thinking';
+
+export interface ActivityEntry {
+  id: string;
+  agentName: string;
+  agentEmoji: string;
+  action: string;
+  description: string;
+  timestamp: string;
+  filePath?: string;
+  toolName?: string;
+  type: ActivityType;
+}
+
+interface ActivityStreamState {
+  activities: ActivityEntry[];
+  paused: boolean;
+  maxEntries: number;
+  addActivity: (entry: ActivityEntry) => void;
+  clearActivities: () => void;
+  setPaused: (paused: boolean) => void;
+  setMaxEntries: (maxEntries: number) => void;
+}
+
+interface UseActivityStreamOptions {
+  gatewayUrl?: string;
+  maxEntries?: number;
+  useMockData?: boolean;
+  mockIntervalRangeMs?: [min: number, max: number];
+}
+
+const DEFAULT_MAX_ENTRIES = 200;
+const DEFAULT_MOCK_INTERVAL_RANGE: [number, number] = [2000, 5000];
+
+const AGENTS = [
+  { name: 'Ada', emoji: '🔮' },
+  { name: 'Spock', emoji: '🖖' },
+  { name: 'Scotty', emoji: '🔧' },
+] as const;
+
+const TYPE_VALUES: ActivityType[] = [
+  'file_edit',
+  'tool_call',
+  'message_sent',
+  'command_run',
+  'research',
+  'thinking',
+];
+
+const MOCK_FILE_PATHS = [
+  'docs/architecture.md',
+  'README.md',
+  'packages/app/src/App.tsx',
+  'packages/server/src/index.ts',
+  'scripts/ralph/prd.json',
+];
+
+const MOCK_TOOL_NAMES = ['ripgrep', 'npm', 'git', 'eslint', 'prettier'];
+
+export const useActivityStreamStore = create<ActivityStreamState>((set) => ({
+  activities: [],
+  paused: false,
+  maxEntries: DEFAULT_MAX_ENTRIES,
+  addActivity: (entry) =>
+    set((state) => {
+      if (state.paused) {
+        return state;
+      }
+      return {
+        activities: [entry, ...state.activities].slice(0, state.maxEntries),
+      };
+    }),
+  clearActivities: () => set({ activities: [] }),
+  setPaused: (paused) => set({ paused }),
+  setMaxEntries: (maxEntries) =>
+    set((state) => ({
+      maxEntries,
+      activities: state.activities.slice(0, maxEntries),
+    })),
+}));
+
+function randomFrom<T>(values: readonly T[]): T {
+  return values[Math.floor(Math.random() * values.length)];
+}
+
+function randomBetween(min: number, max: number): number {
+  return Math.floor(Math.random() * (max - min + 1)) + min;
+}
+
+function createId() {
+  return `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
+}
+
+function normalizeWsUrl(url: string): string {
+  if (url.startsWith('ws://') || url.startsWith('wss://')) {
+    return url;
+  }
+  if (url.startsWith('https://')) {
+    return `wss://${url.slice('https://'.length)}`;
+  }
+  if (url.startsWith('http://')) {
+    return `ws://${url.slice('http://'.length)}`;
+  }
+  return `ws://${url}`;
+}
+
+function normalizeType(value: unknown): ActivityType | null {
+  if (typeof value !== 'string') {
+    return null;
+  }
+  if ((TYPE_VALUES as readonly string[]).includes(value)) {
+    return value as ActivityType;
+  }
+  return null;
+}
+
+function toIsoTimestamp(value: unknown): string {
+  if (typeof value === 'string') {
+    const fromString = new Date(value);
+    if (!Number.isNaN(fromString.getTime())) {
+      return fromString.toISOString();
+    }
+  }
+  if (typeof value === 'number') {
+    const fromNumber = new Date(value);
+    if (!Number.isNaN(fromNumber.getTime())) {
+      return fromNumber.toISOString();
+    }
+  }
+  return new Date().toISOString();
+}
+
+function parseWsActivity(payload: unknown): ActivityEntry | null {
+  if (!payload || typeof payload !== 'object') {
+    return null;
+  }
+
+  const record = payload as Record<string, unknown>;
+  const type =
+    normalizeType(record.activityType) ??
+    normalizeType(record.eventType) ??
+    normalizeType(record.type);
+
+  if (!type) {
+    return null;
+  }
+
+  return {
+    id: typeof record.id === 'string' ? record.id : createId(),
+    agentName: typeof record.agentName === 'string' ? record.agentName : 'Unknown Agent',
+    agentEmoji: typeof record.agentEmoji === 'string' ? record.agentEmoji : '🤖',
+    action: typeof record.action === 'string' ? record.action : 'Reported activity',
+    description: typeof record.description === 'string' ? record.description : 'No description available.',
+    timestamp: toIsoTimestamp(record.timestamp),
+    filePath: typeof record.filePath === 'string' ? record.filePath : undefined,
+    toolName: typeof record.toolName === 'string' ? record.toolName : undefined,
+    type,
+  };
+}
+
+function createMockActivity(): ActivityEntry {
+  const agent = randomFrom(AGENTS);
+  const type = randomFrom(TYPE_VALUES);
+  const filePath = randomFrom(MOCK_FILE_PATHS);
+  const toolName = randomFrom(MOCK_TOOL_NAMES);
+
+  if (type === 'file_edit') {
+    return {
+      id: createId(),
+      agentName: agent.name,
+      agentEmoji: agent.emoji,
+      action: 'Edited file',
+      description: `Updated ${filePath} to reflect latest workspace changes.`,
+      timestamp: new Date().toISOString(),
+      filePath,
+      type,
+    };
+  }
+
+  if (type === 'tool_call') {
+    return {
+      id: createId(),
+      agentName: agent.name,
+      agentEmoji: agent.emoji,
+      action: 'Called tool',
+      description: `Ran ${toolName} to validate the current approach.`,
+      timestamp: new Date().toISOString(),
+      toolName,
+      type,
+    };
+  }
+
+  if (type === 'message_sent') {
+    return {
+      id: createId(),
+      agentName: agent.name,
+      agentEmoji: agent.emoji,
+      action: 'Sent message',
+      description: 'Posted an update to the team channel with current findings.',
+      timestamp: new Date().toISOString(),
+      type,
+    };
+  }
+
+  if (type === 'command_run') {
+    return {
+      id: createId(),
+      agentName: agent.name,
+      agentEmoji: agent.emoji,
+      action: 'Executed command',
+      description: `Executed \`npm run build\` while working on ${filePath}.`,
+      timestamp: new Date().toISOString(),
+      filePath,
+      type,
+    };
+  }
+
+  if (type === 'research') {
+    return {
+      id: createId(),
+      agentName: agent.name,
+      agentEmoji: agent.emoji,
+      action: 'Researching',
+      description: `Gathered references for improving ${filePath}.`,
+      timestamp: new Date().toISOString(),
+      filePath,
+      type,
+    };
+  }
+
+  return {
+    id: createId(),
+    agentName: agent.name,
+    agentEmoji: agent.emoji,
+    action: 'Thinking',
+    description: `Planning the next implementation step for ${filePath}.`,
+    timestamp: new Date().toISOString(),
+    filePath,
+    type: 'thinking',
+  };
+}
+
+export function useActivityStream({
+  gatewayUrl = 'ws://100.106.69.9:18789',
+  maxEntries = DEFAULT_MAX_ENTRIES,
+  useMockData = true,
+  mockIntervalRangeMs = DEFAULT_MOCK_INTERVAL_RANGE,
+}: UseActivityStreamOptions = {}) {
+  const activities = useActivityStreamStore((state) => state.activities);
+  const paused = useActivityStreamStore((state) => state.paused);
+  const storeMaxEntries = useActivityStreamStore((state) => state.maxEntries);
+  const addActivity = useActivityStreamStore((state) => state.addActivity);
+  const clearActivities = useActivityStreamStore((state) => state.clearActivities);
+  const setPaused = useActivityStreamStore((state) => state.setPaused);
+  const setMaxEntries = useActivityStreamStore((state) => state.setMaxEntries);
+  const [connected, setConnected] = useState(false);
+
+  useEffect(() => {
+    const safeMaxEntries = Math.max(1, maxEntries);
+    if (safeMaxEntries !== storeMaxEntries) {
+      setMaxEntries(safeMaxEntries);
+    }
+  }, [maxEntries, setMaxEntries, storeMaxEntries]);
+
+  useEffect(() => {
+    const ws = new WebSocket(normalizeWsUrl(gatewayUrl));
+    ws.onopen = () => setConnected(true);
+    ws.onclose = () => setConnected(false);
+    ws.onerror = () => setConnected(false);
+    ws.onmessage = (event) => {
+      try {
+        const parsed = JSON.parse(event.data) as unknown;
+        const entry = parseWsActivity(parsed);
+        if (entry) {
+          addActivity(entry);
+        }
+      } catch {
+        // Ignore invalid payloads from the gateway.
+      }
+    };
+
+    return () => {
+      ws.close();
+    };
+  }, [addActivity, gatewayUrl]);
+
+  useEffect(() => {
+    if (!useMockData) {
+      return;
+    }
+
+    const [minDelay, maxDelay] = mockIntervalRangeMs;
+    let timerId: number | undefined;
+    let cancelled = false;
+
+    const enqueueMock = () => {
+      if (cancelled) {
+        return;
+      }
+
+      const delay = randomBetween(minDelay, maxDelay);
+      timerId = window.setTimeout(() => {
+        addActivity(createMockActivity());
+        enqueueMock();
+      }, delay);
+    };
+
+    enqueueMock();
+
+    return () => {
+      cancelled = true;
+      if (timerId !== undefined) {
+        window.clearTimeout(timerId);
+      }
+    };
+  }, [addActivity, mockIntervalRangeMs, useMockData]);
+
+  const pause = useCallback(() => setPaused(true), [setPaused]);
+  const resume = useCallback(() => setPaused(false), [setPaused]);
+  const togglePause = useCallback(() => setPaused(!paused), [paused, setPaused]);
+
+  return {
+    activities,
+    connected,
+    paused,
+    maxEntries: storeMaxEntries,
+    pause,
+    resume,
+    togglePause,
+    clearActivities,
+  };
+}
