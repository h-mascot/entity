+                    <span className="flex-1 truncate text-[var(--text-muted)]">{currentFile}</span>
+                    <button
+                      onClick={() => setEditMode(!editMode)}
+                      className="rounded bg-[var(--bg-tertiary)] px-2 py-1 text-[11px] text-[var(--text-secondary)]"
+                    >
+                      {editMode ? 'Preview' : 'Edit'}
+                    </button>
+                    {editMode && !watchMode && (
+                      <button
+                        onClick={handleSave}
+                        className="rounded bg-[var(--success)] px-2 py-1 text-[11px] font-medium text-black"
+                      >
+                        Save
+                      </button>
+                    )}
+                  </div>
+                  <div className="min-h-0 flex-1 overflow-auto">
+                    {editMode ? (
+                      <CodeMirrorEditor
+                        content={fileContent}
+                        onChange={handleContentChange}
+                        onSave={handleSave}
+                        readOnly={watchMode}
+                      />
+                    ) : (
+                      <div className="mx-auto max-w-3xl p-4">
+                        <MarkdownPreview content={fileContent} />
+                      </div>
+                    )}
+                  </div>
