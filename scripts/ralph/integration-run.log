+          `API: ${API_HEALTH_URL} (${apiAlreadyRunning ? 'up' : 'down'})`
+      );
+    }
+    return;
+  }
+
+  if (!apiAlreadyRunning) {
+    startManagedProcess('server', ['--prefix', 'packages/server', 'run', 'dev']);
+  }
+
+  if (!appAlreadyRunning) {
