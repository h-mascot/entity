+    allowFailure = false,
+    cwd = ROOT_DIR,
+    env = process.env,
+    timeoutMs = 60000,
+  } = options;
+
+  const result = spawnSync(command, args, {
+    cwd,
+    env,
+    encoding: 'utf8',
+    timeout: timeoutMs,
+    maxBuffer: 10 * 1024 * 1024,
+  });
