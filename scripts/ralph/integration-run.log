+        onChange={(tab) => {
+          setMobileTab(tab);
+          if (tab === 'tasks') {
+            setSidebarTab('tasks');
+            return;
+          }
+          if (tab === 'files' || tab === 'agents') {
+            setSidebarTab(tab);
+          }
+        }}
+      />
     </div>
   );
 }
