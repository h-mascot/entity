diff --git a/packages/app/src/hooks/useIsMobile.ts b/packages/app/src/hooks/useIsMobile.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cc6e185e73ecd9700ba9a18231225d7412f94ba0
--- /dev/null
+++ b/packages/app/src/hooks/useIsMobile.ts
@@ -0,0 +1,26 @@
+import { useEffect, useState } from 'react';
+
+const MOBILE_BREAKPOINT = 768;
+
+function getIsMobile() {
+  if (typeof window === 'undefined') {
+    return false;
+  }
+
+  return window.innerWidth < MOBILE_BREAKPOINT;
+}
+
+export function useIsMobile() {
+  const [isMobile, setIsMobile] = useState(getIsMobile);
+
+  useEffect(() => {
+    const onResize = () => {
+      setIsMobile(getIsMobile());
+    };
+
+    window.addEventListener('resize', onResize);
+    return () => window.removeEventListener('resize', onResize);
+  }, []);
+
+  return isMobile;
+}
