+function registerDbModeRoutes(prefix: '' | '/api') {
+  const base = `${prefix}/db-mode`;
+
+  app.get(base, (_req, res) => {
+    res.json({
+      mode: taskSyncLayer.getMode(),
+      cloudConfigured: taskSyncLayer.hasCloudAdapter(),
+    });
+  });
