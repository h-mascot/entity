+async function main() {
+  try {
+    ensureAgentBrowser();
+    await startServersIfNeeded();
+    await runE2e();
+  } finally {
+    runAgentBrowser(['close'], { allowFailure: true });
+    await stopManagedProcesses();
+  }
+}
+
+main().catch((error) => {
+  console.error(error instanceof Error ? error.message : String(error));
+  process.exitCode = 1;
+});
