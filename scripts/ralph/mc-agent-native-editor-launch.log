+    }
+
+    builder.add(
+      start,
+      end,
+      Decoration.mark({
+        class: classNames.join(' '),
+      })
+    );
+  }
+
+  return builder.finish();
+}
+
+function buildAuthorshipDecorationsField(ranges: readonly EditorAuthorshipRange[]) {
+  return StateField.define<DecorationSet>({
