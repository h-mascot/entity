+    throw new EditorServiceError('INVALID_EDIT_RANGE', `${fieldName} must be a non-negative integer.`, 400);
+  }
+
+  return value;
+}
+
+function computeContentHash(content: string): string {
+  return createHash('sha1').update(content, 'utf8').digest('hex');
