+    return normalized as DocumentAuthorshipActor;
+  }
+
+  return 'human';
+}
+
+function toPercent(part: number, whole: number): number {
+  if (whole <= 0) {
+    return 0;
+  }
+
+  return Number(((part / whole) * 100).toFixed(2));
+}
+
+function createEmptyAuthorStats(): DocumentAuthorshipAuthorStats {
+  return {
+    ranges: 0,
+    reviewedRanges: 0,
+    coveredCharacters: 0,
+  };
