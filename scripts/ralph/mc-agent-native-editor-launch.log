+    if (range.reviewed) {
+      classNames.push('cm-authorship-reviewed');
+    }
+
+    builder.add(
+      start,
+      end,
+      Decoration.mark({
+        class: classNames.join(' '),
+      })
+    );
+  }
+
+  return builder.finish();
+}
