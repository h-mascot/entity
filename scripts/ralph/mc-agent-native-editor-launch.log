+  stats.spock = toPercent(stats.byAuthor.spock?.coveredCharacters ?? 0, stats.coveredCharacters);
+  stats.scotty = toPercent(stats.byAuthor.scotty?.coveredCharacters ?? 0, stats.coveredCharacters);
+  return stats;
+}
