+          return;
+        }
+
+        res.status(400).json({
+          code: 'INVALID_SUGGESTION_STATUS',
+          error: "status must be either 'accepted' or 'rejected'.",
+        } satisfies EditorRouteErrorBody);
+      } catch (error) {
+        const mapped = mapRouteError(error);
+        res.status(mapped.status).json(mapped.body);
