+        return;
+      }
+
+      if (!isRecord(req.body)) {
+        res.status(400).json({
+          code: 'INVALID_SUGGESTION_UPDATE_PAYLOAD',
+          error: 'Suggestion update payload must be a JSON object.',
+        } satisfies EditorRouteErrorBody);
+        return;
