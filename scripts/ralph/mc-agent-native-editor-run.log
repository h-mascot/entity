  const normalized = docId.trim();
  if (!normalized) {
    return { sourceId: null, path: null };
  }

  const idx = normalized.indexOf(':');
  if (idx < 1) {
    return { sourceId: null, path: null };
  }

  const prefix = normalized.slice(0, idx).trim();
